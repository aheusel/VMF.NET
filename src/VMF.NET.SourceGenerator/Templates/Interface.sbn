{{~ # Interface template — generates the PUBLIC interface for a model type.
   #
   # The model interface itself is build input, living in the `.VmfModel` namespace and never
   # part of the API, so everything a consumer sees is declared here: the members, the base
   # interfaces, the Builder, Clone/AsReadOnly and the static factories.
   #
   # It stays `partial` so a consumer can add their own members to it — the model file cannot,
   # since it is a different type in a different namespace. ~}}
// <auto-generated>
// This code was generated by VMF.NET. Do not edit manually.
// </auto-generated>
#nullable enable

using System;
using System.Collections.Generic;
using System.ComponentModel;
using VMF.NET.Runtime;
using VMF.NET.Runtime.Attributes;

namespace {{ ns }}
{
{{~ if type.IsDocumented ~}}
    /// <summary>{{ xml_doc type.Documentation }}</summary>
{{~ end ~}}
    public partial interface {{ type.TypeName }} : IVObject, {{ if type.IsImmutable }}IImmutable{{ else }}IMutable{{ end }}{{ for base_type in type.Implements }}, {{ base_type.TypeName }}{{ end }}
    {
{{~ # --- Members declared by this type ---
   # `new` where a base declares the same name: the model narrows or re-states it, and C# wants
   # the hiding spelled out. ~}}
{{~ for prop in own_props ~}}
{{~ if prop.IsDocumented ~}}
        /// <summary>{{ xml_doc prop.Documentation }}</summary>
{{~ end ~}}
{{~ hiding = hides_base prop.Name ? "new " : "" ~}}
{{~ # An immutable type is built once and never written to, so nothing gets a setter. ~}}
{{~ settable = !type.IsImmutable && !(prop.IsGetterOnly) ~}}
{{~ if prop.IsCollectionType ~}}
        {{ hiding }}VList<{{ elem_type_name prop }}> {{ prop.Name }} { get; }
{{~ else if prop.IsContainer ~}}
{{~ # A container is settable exactly when it has an opposite to drive, which is when the
   # implementation generates a setter. Java always generates one; here there is nothing to
   # drive without an opposite. ~}}
        {{ hiding }}{{ prop_type_name prop }}? {{ prop.Name }} { get;{{ if settable && prop.Containment != null && prop.Containment.OppositeProp != null }} set;{{ end }} }
{{~ else if prop.IsModelType ~}}
        {{ hiding }}{{ prop_type_name prop }}? {{ prop.Name }} { get;{{ if settable }} set;{{ end }} }
{{~ else ~}}
        {{ hiding }}{{ prop_type_name prop }}{{ if (is_nullable prop) }}?{{ end }} {{ prop.Name }} { get;{{ if settable }} set;{{ end }} }
{{~ end ~}}
{{~ end ~}}
{{~ for del in type.OwnMethodDelegations ~}}
{{~ if del.IsDocumented ~}}
        /// <summary>{{ xml_doc del.Documentation }}</summary>
{{~ end ~}}
        {{ hides_base del.MethodName ? "new " : "" }}{{ del.ReturnType }} {{ del.MethodName }}({{ for i in 0..(del.ParamTypes.size - 1) }}{{ if i > 0 }}, {{ end }}{{ del.ParamTypes[i] }} {{ del.ParamNames[i] }}{{ end }});
{{~ end ~}}

{{~ if !(type.IsInterfaceOnly) ~}}
        /// <summary>Creates a new builder for this type.</summary>
        static {{ type.TypeName }}.Builder NewBuilder() => new {{ type.ImplClassName }}.BuilderImpl();

        /// <summary>Creates a new instance of this type.</summary>
        static {{ type.TypeName }} NewInstance() => new {{ type.ImplClassName }}();

        /// <summary>
        /// Returns the type object for this model type, which supports reflection without an
        /// instance: <c>ModelType().Reflect()</c>.
        /// <para>
        /// Java calls this <c>type()</c>. C# cannot: a model is free to declare a property named
        /// <c>Type</c> (several do), and a method may not share a name with a property on the same
        /// interface. <c>ModelType</c> is the collision-free equivalent.
        /// </para>
        /// </summary>
        static VmfType ModelType() => new {{ type.ImplClassName }}().GetVmfType();

        /// <summary>Typed deep clone.</summary>
        new {{ type.TypeName }} Clone();

        /// <summary>Returns a typed read-only wrapper.</summary>
        new {{ type.ReadOnlyInterfaceName }} AsReadOnly();

        /// <summary>Builder interface for {{ type.TypeName }}.</summary>
        interface Builder : IBuilder
        {
{{~ for prop in all_props ~}}
{{~ if !(prop.IsContainer) ~}}
{{~ if prop.IsCollectionType ~}}
            Builder With{{ prop.Name }}(params {{ elem_type_name prop }}[] values);
{{~ if prop.GenericModelType != null && !prop.GenericModelType.IsInterfaceOnly ~}}
            /// <summary>Accepts nested builders unbuilt; they are built by <see cref="Build"/>.</summary>
            Builder With{{ prop.Name }}(params {{ prop.GenericModelType.TypeName }}.Builder[] values);
{{~ end ~}}
{{~ else ~}}
            Builder With{{ prop.Name }}({{ prop_type_name prop }}{{ if (is_nullable prop) }}?{{ end }} value);
{{~ if prop.IsModelType && prop.ModelType != null && !prop.ModelType.IsInterfaceOnly ~}}
            /// <summary>Accepts a nested builder unbuilt; it is built by <see cref="Build"/>.</summary>
            Builder With{{ prop.Name }}({{ prop.ModelType.TypeName }}.Builder value);
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
            new {{ type.TypeName }} Build();
            Builder ApplyFrom({{ type.TypeName }} source);
            Builder ApplyTo({{ type.TypeName }} target);
        }
{{~ end ~}}
    }
}
