<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      Writes the generated sources to obj/<cfg>/<tfm>/generated so they can be read. Worth keeping:
      almost every generator bug this project has had was diagnosed by looking at the output.

      The catch is that these files are NOT tracked as build outputs, so nothing ever deletes them.
      Rename a model type and the old file stays on disk beside the new one forever. Measured
      2026-08-25 after renaming 260 models: 1772 files present where a clean run emits 1168, with
      259 stale interfaces still sitting there under their previous names.

      That is not a compile hazard (obj is outside the default compile glob) but it is a first-rate
      red herring when something looks wrong, so `Clean` now removes them.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <Target Name="_RemoveGeneratedFilesOnClean" AfterTargets="Clean">
    <RemoveDir Directories="$(CompilerGeneratedFilesOutputPath)" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" PrivateAssets="all" />
    <!-- Scriban is needed by the generator at compile time -->
    <PackageReference Include="Scriban" Version="5.*" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMF.NET.Runtime\VMF.NET.Runtime.csproj" />
    <ProjectReference Include="..\VMF.NET.Json\VMF.NET.Json.csproj" />
    <!-- Source generator as analyzer -->
    <ProjectReference Include="..\VMF.NET.SourceGenerator\VMF.NET.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Core is loaded by the generator at compile time -->
    <ProjectReference Include="..\VMF.NET.Core\VMF.NET.Core.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Feed Scriban to the compiler so the generator can load it.

    This MUST be a plain ItemGroup, NOT a target hooked BeforeTargets="CoreCompile".

    Visual Studio's design-time build does not run CoreCompile, so the target-based version this
    replaces never fired in the IDE. The generator was then handed to Roslyn without its Scriban
    dependency, failed to load, and produced no types. Since C-6 the whole public API is
    generated, so every reference to a generated interface went unresolved and IntelliSense died
    across the project. `dotnet build` was unaffected, because there CoreCompile does run, which
    is why the suite stayed green while the IDE showed a sea of red.

    Verify with:
      dotnet msbuild src/VMF.NET.TestSuite/VMF.NET.TestSuite.csproj -t:ResolveProjectReferences -getItem:Analyzer
    Scriban.dll must appear WITHOUT CoreCompile in the target list.

    $(PkgScriban) comes from GeneratePathProperty="true" on the PackageReference above; restore
    writes it into obj/*.nuget.g.props, which is imported during evaluation. The condition keeps
    a pre-restore evaluation from contributing a bogus path.
  -->
  <ItemGroup Condition="'$(PkgScriban)' != ''">
    <Analyzer Include="$(PkgScriban)\lib\netstandard2.0\Scriban.dll" />
  </ItemGroup>

</Project>
